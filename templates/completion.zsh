# zsh completion for "__CB_NAME__" — generated by cmd-builder, do not edit.
__CB_FUNC__() {
  local -a lines cands
  local line val desc
  lines=("${(@f)$(__CB_NAME__ __complete -- "${(@)words[2,CURRENT]}" 2>/dev/null)}")
  for line in "${lines[@]}"; do
    [[ -z $line ]] && continue
    val=${line%%$'\t'*}
    desc=${line#*$'\t'}
    val=${val//:/\\:}
    if [[ -n $desc && $desc != $line ]]; then
      cands+=("$val:$desc")
    else
      cands+=("$val")
    fi
  done
  if (( ${#cands} )); then
    _describe -t commands '__CB_NAME__' cands
  else
    _files
  fi
}
if (( ! $+functions[compdef] )); then
  # -i: skip insecure directories instead of asking at every shell start.
  autoload -Uz compinit && compinit -i
fi
compdef __CB_FUNC__ __CB_NAME__
